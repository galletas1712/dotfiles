export EDITOR=vim
# Use image executables when the host home is shared with a Linux container.
if [[ ${DEV_CONTAINER:-} == 1 ]]; then
  export PATH="/usr/local/bin:/usr/local/go/bin:/usr/local/sbin:/usr/sbin:/usr/bin:/sbin:/bin"
else
  export PATH="$HOME/.local/bin:$HOME/.docker/bin:$HOME/snap/bin:$PATH"

  # Make Homebrew tools available in the shell.
  for brew_bin in /opt/homebrew/bin/brew /usr/local/bin/brew /home/linuxbrew/.linuxbrew/bin/brew; do
    if [ -x "$brew_bin" ]; then
      eval "$("$brew_bin" shellenv)"
      break
    fi
  done
  export PATH="$HOME/.local/bin:$PATH"
fi

autoload -Uz compinit
compinit

if command -v kubectl >/dev/null 2>&1; then
  source <(kubectl completion zsh)
fi
if command -v starship >/dev/null 2>&1; then
  eval "$(starship init zsh)"
fi

if command -v zmx >/dev/null 2>&1; then
  eval "$(zmx completions zsh)"
fi
alias za="zmx attach"
alias zl="zmx list"
alias zk="zmx kill"

if [[ ${DEV_CONTAINER:-} != 1 && -r "$HOME/.zshrc.local" ]]; then
  source "$HOME/.zshrc.local"
fi
